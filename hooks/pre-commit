#!/bin/bash
# Pre-commit hook for CodeReview AI
# Install: ln -s ../../hooks/pre-commit .git/hooks/pre-commit

set -e

echo "=========================================="
echo "  CodeReview AI - Pre-commit Hook"
echo "=========================================="
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
FAIL_THRESHOLD=${CODEREVIEW_THRESHOLD:-70}
REPORT_FORMAT=${CODEREVIEW_FORMAT:-console}
CONFIG_FILE=${CODEREVIEW_CONFIG:-}
PYTHON_CMD=${CODEREVIEW_PYTHON:-python3}

# Find the review tool
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
REVIEW_TOOL="${PROJECT_ROOT}/src/cli.py"

# Check if tool exists
if [ ! -f "$REVIEW_TOOL" ]; then
    echo -e "${YELLOW}Warning: CodeReview AI not found at $REVIEW_TOOL${NC}"
    echo -e "${YELLOW}Skipping code review check.${NC}"
    exit 0
fi

# Get list of Python files to check
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${BLUE}No Python files staged. Skipping review.${NC}"
    exit 0
fi

echo -e "${BLUE}Found $(echo "$STAGED_FILES" | wc -l) Python file(s) to review.${NC}"
echo ""

# Build command
CMD="$PYTHON_CMD $REVIEW_TOOL analyze"

if [ -n "$CONFIG_FILE" ]; then
    CMD="$CMD -c $CONFIG_FILE"
fi

CMD="$CMD --fail-threshold $FAIL_THRESHOLD --format console"

# Analyze each staged file
FAILED=0
TOTAL_ISSUES=0

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        echo -e "${BLUE}Reviewing: $file${NC}"
        
        if $CMD "$file" 2>/dev/null; then
            echo -e "${GREEN}  Passed: $file${NC}"
        else
            echo -e "${RED}  Issues found in: $file${NC}"
            FAILED=$((FAILED + 1))
        fi
        echo ""
    fi
done

echo "=========================================="

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}All staged files passed code review!${NC}"
    echo "=========================================="
    exit 0
else
    echo -e "${RED}$FAILED file(s) failed code review.${NC}"
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    echo -e "  1. Fix the issues and stage again"
    echo -e "  2. Skip the check with: git commit --no-verify"
    echo -e "  3. Adjust threshold: CODEREVIEW_THRESHOLD=50 git commit"
    echo "=========================================="
    exit 1
fi
